{
  "name": "opencode-v2-plugin-starter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Minimal OpenCode 2 native plugin starter with optional TUI entrypoint.",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "check:v2": "node scripts/check-v2.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run check:v2 && bun run typecheck && bun test"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.16"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.16",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.12",
    "@types/bun": "latest",
    "solid-js": "1.9.15",
    "typescript": "latest"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
